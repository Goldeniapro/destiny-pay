# Anthropic (https://console.anthropic.com > API keys)
ANTHROPIC_API_KEY=

# PayPal Developer > Apps & Credentials > Sandbox app. Leave both empty to run in demo mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Webhook id from the sandbox app's Webhooks section (URL: https://<your-app>/api/paypal/webhook)
PAYPAL_WEBHOOK_ID=
# PayPal Invoicing does not support PEN, COP, CLP or ARS. USD, MXN, EUR and GBP work.
DP_CURRENCY=USD

# Optional: Destiny Pay's own voice (https://fish.audio). A native voice per language sounds best;
# FISH_VOICE_ID is used for any language without its own voice.
FISH_API_KEY=
FISH_VOICE_ID_ES=bfed5c0810a347dbb62e8ccce7f59c48
FISH_VOICE_ID_EN=933563129e564b19a115bedd57b7406a
FISH_VOICE_ID_PT=ca0326921a254a7295650b2cf85fe098
FISH_VOICE_ID=
# FISH_MODEL=s2.1-pro

# Where the business memory lives (SQLite)
# DP_DB_PATH=data/destiny_pay.db

# Optional tuning
# DP_EFFORT=low                 # low | medium | high
# DP_CHAT_PER_MINUTE=15         # per visitor IP
# DP_GLOBAL_PER_MINUTE=120      # whole server
# DP_DAILY_TOKEN_BUDGET=3000000 # whole server, per day
# DP_TTS_DAILY_BYTES=2000000    # voice budget per day (about US$30)
