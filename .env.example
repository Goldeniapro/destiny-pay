# Anthropic (https://console.anthropic.com > API keys)
ANTHROPIC_API_KEY=

# PayPal Developer > Apps & Credentials > Sandbox app. Leave both empty to run in demo mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# PayPal Invoicing does not support PEN, COP, CLP or ARS. USD, MXN, EUR and GBP work.
DP_CURRENCY=USD

# Optional tuning
# DP_EFFORT=low                 # low | medium | high
# DP_CHAT_PER_MINUTE=12         # per visitor IP
# DP_GLOBAL_PER_MINUTE=90       # whole server
# DP_MAX_TURNS=40               # per session
# DP_DAILY_TOKEN_BUDGET=3000000 # whole server, per day
